# Copy to .env.local for local overrides. No secrets belong in this app: the
# login is a PBKDF2 vault in lib/login-vault.json (see README → Access control),
# and the optional sync token is entered in Settings and stored encrypted in the browser.

# Path prefix the site is served under. Empty for local dev and custom domains;
# the Pages workflow sets it to /fundamentals-tracker automatically.
NEXT_PUBLIC_BASE_PATH=

# Private repo that stores progress.json. Fixed at build time.
NEXT_PUBLIC_DATA_OWNER=bhargavaramkv
NEXT_PUBLIC_DATA_REPO=fundamentals-tracker-data
