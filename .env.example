# Copy to .env.local for local overrides. No secrets belong in this app:
# it is a static site, and the optional GitHub sync token is entered in the
# app's Settings page and kept only in your browser's localStorage.

# Path prefix the site is served under. Empty for local dev and custom domains;
# the Pages workflow sets it to /fundamentals-tracker automatically.
NEXT_PUBLIC_BASE_PATH=

# Private repo whose access unlocks the app and stores progress.json.
# Fixed at build time so a visitor can't point the sign-in at their own repo.
NEXT_PUBLIC_DATA_OWNER=bhargavaramkv
NEXT_PUBLIC_DATA_REPO=fundamentals-tracker-data
